{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ShraddhaSurana/f2x50/schemas/source-information.schema.json",
  "title": "f2x50 source-information record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "probe_id",
    "oracle_kind",
    "upstream_path",
    "upstream_symbol",
    "upstream_start_line",
    "upstream_end_line",
    "harness_path",
    "harness_start_line",
    "harness_end_line",
    "audit_status",
    "audit_note"
  ],
  "properties": {
    "probe_id": {"type": "string", "pattern": "^f2x50-(low|medium|complex)-[a-z0-9-]+-[0-9]{3}$"},
    "oracle_kind": {
      "enum": [
        "original-file-plus-driver",
        "extracted-source",
        "f2py-wrapper",
        "inline-reimplementation",
        "synthetic-fixture"
      ]
    },
    "upstream_path": {"type": "string"},
    "upstream_symbol": {"type": "string"},
    "upstream_start_line": {"type": "string", "pattern": "^$|^[1-9][0-9]*$"},
    "upstream_end_line": {"type": "string", "pattern": "^$|^[1-9][0-9]*$"},
    "harness_path": {"type": "string", "pattern": "^harness/python/.+\\.py$"},
    "harness_start_line": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "harness_end_line": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "audit_status": {"const": "verified"},
    "audit_note": {"type": "string", "minLength": 1}
  }
}
